---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Intro from "../components/sections/Intro.astro";
import Tent from "../components/sections/Tent.astro";
import Stats from "../components/sections/Stats.astro";
import Occasions from "../components/sections/Occasions.astro";
import Packages from "../components/sections/Packages.astro";
import Process from "../components/sections/Process.astro";
import DesignTeaser from "../components/sections/DesignTeaser.astro";
import Area from "../components/sections/Area.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";
import { localBusiness, product, faqPage } from "../data/schema";
---

<BaseLayout preloader floatingCta jsonLd={[localBusiness, product, faqPage]}>
  <Hero />
  <Intro />
  <Tent />
  <Stats />
  <Occasions />
  <Packages />
  <Process />
  <DesignTeaser />
  <Area />
  <Faq />
  <Contact />
</BaseLayout>
