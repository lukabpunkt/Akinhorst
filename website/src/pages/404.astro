---
import { url } from "../data/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Seite nicht gefunden | Bakin & Horst Event Design" description="Diese Seite gibt es leider nicht." noindex solidHeader>
  <section class="nf">
    <div class="container nf__inner">
      <p class="nf__num" aria-hidden="true">4<span>0</span>4</p>
      <h1>Hier ist leider <em class="accent">kein Fest</em>.</h1>
      <p class="lead">Die Seite, die ihr sucht, gibt es nicht (mehr). Vielleicht hilft euch die Startseite weiter.</p>
      <div class="nf__ctas">
        <Button href={url("/")} arrow>Zur Startseite</Button>
        <Button href={url("/#kontakt")} variant="ghost">Termin anfragen</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 3rem) 5rem;
    text-align: center;
  }
  .nf__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .nf__num {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(6rem, 18vw, 12rem);
    line-height: 1;
    margin: 0 0 1rem;
  }
  .nf__num span {
    color: var(--gold);
    font-style: italic;
  }
  h1 {
    margin: 0 0 1.5rem;
  }
  .lead {
    max-width: 30rem;
    margin: 0 0 2.5rem;
  }
  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
