---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import MobileMenu from "./MobileMenu.astro";
import { nav } from "../data/nav";

interface Props {
  solid?: boolean; // Unterseiten: immer dunkle Schrift
}
const { solid = false } = Astro.props;
const home = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const prefix = home ? "" : "/";
---

<header class:list={["header", { "header--solid": solid }]} data-header>
  <div class="container header__inner">
    <a href="/" class="header__brand" aria-label="Bakin & Horst – zur Startseite">
      <Logo variant="compact" tone="dark" />
    </a>
    <nav class="nav" aria-label="Hauptnavigation">
      {nav.map((item) => <a class="nav__link" href={`${prefix}#${item.id}`}>{item.label}</a>)}
    </nav>
    <div class="header__actions">
      <Button href={`${prefix}#kontakt`} class="header__cta">Termin anfragen</Button>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mmenu" aria-label="Menü öffnen" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
<MobileMenu prefix={prefix} />
