---
/** Feine Line-Icons (1,25 px Strich). */
interface Props {
  name: "phone" | "whatsapp" | "mail" | "instagram" | "pin" | "arrow" | "arrow-up" | "plus" | "check";
  class?: string;
}
const { name, class: cls = "icon" } = Astro.props;
---

<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11.5 11.5 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.8 1.8 0 0 1-1.9 1.8C10.3 20.3 3.7 13.7 3.2 5.4A1.8 1.8 0 0 1 5 3.5Z" />}
  {name === "whatsapp" && (
    <>
      <path d="M3.6 20.4 4.8 16A8.6 8.6 0 1 1 8 19.2Z" />
      <path d="M9 8.3c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.1.3 0 .5a6 6 0 0 0 2.5 2.3c.2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .8-.6 1.8-1.7 1.9-1 .1-2.8-.4-4.7-2.2-1.6-1.6-2.4-3.3-2.3-4.2.1-.6.3-1.1.5-1.4Z" />
    </>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5.5" width="18" height="13" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
  {name === "instagram" && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "pin" && (
    <>
      <path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.8" r="2.3" />
    </>
  )}
  {name === "arrow" && <path d="M2 12h19M16 7l5 5-5 5" />}
  {name === "arrow-up" && <path d="M12 21V3M7 8l5-5 5 5" />}
  {name === "plus" && <path d="M12 4v16M4 12h16" />}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
</svg>
