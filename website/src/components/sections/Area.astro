---
import Eyebrow from "../Eyebrow.astro";
import { site } from "../../data/site";

// Ungefähre Koordinaten für die stilisierte Karte (keine echte Karte, kein externer Dienst)
// TODO(INHABER): welches „Lohne“? Hier: Lohne (Oldenburg)
const coords: Record<string, [number, number]> = {
  Rahden: [52.433, 8.613],
  Espelkamp: [52.377, 8.622],
  Stemwede: [52.423, 8.447],
  Diepenau: [52.42, 8.73],
  Rehden: [52.61, 8.48],
  Wagenfeld: [52.55, 8.583],
  Lohne: [52.666, 8.238],
  "Preußisch Oldendorf": [52.3, 8.497],
};
const project = ([lat, lon]: [number, number]) => ({
  x: 70 + (lon - 8.2) * 68 * 11.5,
  y: 50 + (52.7 - lat) * 111 * 11.5,
});
const center = project(coords.Rahden);
// Beschriftung je Ort so platzieren, dass nichts den Rahden-Marker überdeckt oder aus dem Bild läuft
const labelSide: Record<string, "left" | "right" | "below"> = { Stemwede: "left", Diepenau: "below", "Preußisch Oldendorf": "below" };
const places = site.areas
  .filter((a) => a !== "Rahden" && coords[a])
  .map((name) => ({ name, side: labelSide[name] ?? (project(coords[name]).x < 520 ? "right" : "left"), ...project(coords[name]) }));
const label = (p: { x: number; y: number; side: string }) =>
  p.side === "below"
    ? { x: p.side === "below" && p.x > 480 ? p.x + 8 : p.x, y: p.y + 30, anchor: p.x > 480 ? "end" : "middle" }
    : { x: p.x + (p.side === "right" ? 12 : -12), y: p.y + 6, anchor: p.side === "right" ? "start" : "end" };
---

<section class="section area" id="liefergebiet" aria-labelledby="area-title" data-loop>
  <div class="container area__grid">
    <div class="area__text">
      <Eyebrow text="Liefergebiet" align="left" />
      <h2 id="area-title" data-anim="lines">Zuhause in <em class="accent">Rahden.</em> Unterwegs für euch.</h2>
      <p class="lead" data-anim="fade-up">Wir liefern und bauen in Rahden und der ganzen Umgebung im Kreis Minden-Lübbecke und darüber hinaus auf – zum Beispiel in:</p>
      <ul class="area__list" data-anim="stagger">
        {site.areas.map((a) => <li>{a}</li>)}
      </ul>
      <p class="area__note" data-anim="fade-up">Ihr feiert weiter weg? <a class="tlink" href="#kontakt">Fragt einfach an</a> – wir finden eine Lösung.</p>
    </div>
    <div class="area__map" data-area-map>
      <svg viewBox="0 0 600 600" role="img" aria-label="Stilisierte Karte: Rahden im Zentrum, umliegende Orte im Liefergebiet">
        <defs>
          <pattern id="area-dots" width="18" height="18" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="var(--stone)" />
          </pattern>
        </defs>
        <rect width="600" height="600" fill="url(#area-dots)" />
        <circle cx={center.x} cy={center.y} r="230" fill="none" stroke="var(--stone)" stroke-dasharray="2 6" />
        <circle cx={center.x} cy={center.y} r="130" fill="none" stroke="var(--stone)" stroke-dasharray="2 6" />
        <g class="area__links">
          {places.map((p) => (
            <line x1={center.x} y1={center.y} x2={p.x.toFixed(1)} y2={p.y.toFixed(1)} pathLength="1" data-area-line />
          ))}
        </g>
        {[0, 1, 2].map((i) => (
          <circle class="area__pulse" cx={center.x} cy={center.y} r="14" style={`animation-delay:${i}s`} />
        ))}
        <g class="area__places">
          {places.map((p) => {
            const l = label(p);
            return (
              <g class="area__place" data-area-place>
                <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="4" />
                <text x={l.x.toFixed(1)} y={l.y.toFixed(1)} text-anchor={l.anchor}>{p.name}</text>
              </g>
            );
          })}
        </g>
        <circle cx={center.x} cy={center.y} r="9" fill="var(--gold)" />
        <circle cx={center.x} cy={center.y} r="16" fill="none" stroke="var(--gold)" />
        <text class="area__home" x={center.x + 24} y={center.y - 22}>Rahden</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .area__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .area h2 {
    margin: 0 0 1.75rem;
  }
  .area .lead {
    margin: 0 0 2rem;
    max-width: 32rem;
  }
  .area__list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
  }
  .area__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--stone);
  }
  .area__list li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
  }
  .area__note {
    margin: 0;
    color: var(--ink-soft);
  }
  .area__map svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .area__links line {
    stroke: var(--gold);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.55;
  }
  .area__place circle {
    fill: var(--ivory);
    stroke: var(--ink-soft);
    stroke-width: 1.25;
  }
  .area__place text {
    font-family: var(--font-sans);
    /* Mobile first: SVG wird klein skaliert → größere Schrift, damit Ortsnamen lesbar bleiben */
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.08em;
    fill: var(--ink-soft);
  }
  /* heller Rand um die Schrift, damit Linien darunter nicht stören */
  .area__place text,
  .area__home {
    paint-order: stroke;
    stroke: var(--ivory);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
  .area__home {
    font-family: var(--font-serif);
    font-size: 30px;
    font-style: italic;
    fill: var(--ink);
  }
  .area__pulse {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: area-pulse 3s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    opacity: 0;
  }
  @keyframes area-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(5);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .area__pulse {
      animation: none;
    }
  }
  @media (min-width: 768px) {
    .area__place text {
      font-size: 17px;
    }
  }
  @media (min-width: 1024px) {
    .area__place text {
      font-size: 15px;
    }
    .area__grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 3.5rem;
    }
    .area__text {
      grid-column: 1 / span 5;
    }
    .area__map {
      grid-column: 7 / span 6;
    }
  }
</style>
