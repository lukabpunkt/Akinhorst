---
import { Picture } from "astro:assets";
import Button from "../Button.astro";
import innen from "../../assets/zelt-innen-hochzeit.jpg";
---

<section class="teaser" id="event-design" aria-labelledby="ed-title" data-teaser>
  <div class="teaser__clip" data-teaser-clip>
    <div class="teaser__img" data-teaser-img>
      <Picture src={innen} formats={["avif", "webp"]} width={1800} widths={[768, 1280, 1800]} sizes="100vw" quality={70} alt="Festlich gedeckte lange Tafel mit Schleierkraut, weißen Rosen und Traubogen im Partyzelt" loading="lazy" />
    </div>
    <div class="teaser__shade" aria-hidden="true"></div>
  </div>
  <div class="container teaser__content on-dark-text">
    <p class="eyebrow eyebrow--light eyebrow--left" data-anim="eyebrow">Event Design</p>
    <h2 id="ed-title" data-anim="lines">Mehr als ein Zelt – <em class="accent accent--light">ein Ort zum Erinnern.</em></h2>
    <p class="teaser__text" data-anim="fade-up">Auf Wunsch gestalten wir eure Feier komplett: von der festlich gedeckten Tafel bis zum Blumenbogen.</p>
    <div data-anim="fade-up">
      <Button href="?paket=event-design#kontakt" data-paket="event-design">Event Design anfragen</Button>
    </div>
  </div>
</section>

<style>
  .teaser {
    position: relative;
    min-height: 90vh;
    min-height: 90svh;
    display: flex;
    align-items: flex-end;
    color: var(--ivory);
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--night);
    isolation: isolate;
  }
  .teaser__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: -1;
    background: var(--night);
  }
  .teaser__img {
    position: absolute;
    inset: -12% 0;
  }
  .teaser__img :global(picture),
  .teaser__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }
  .teaser__shade {
    position: absolute;
    inset: 0;
    /* Mobil: Text steht über dem hellen Bild – senkrechter, kräftigerer Verlauf für Lesbarkeit */
    background: linear-gradient(0deg, rgba(22, 21, 19, 0.9) 0%, rgba(22, 21, 19, 0.78) 55%, rgba(22, 21, 19, 0.2) 100%);
  }
  @media (min-width: 768px) {
    .teaser__shade {
      background: linear-gradient(20deg, rgba(22, 21, 19, 0.82) 0%, rgba(22, 21, 19, 0.5) 40%, rgba(22, 21, 19, 0.05) 75%);
    }
  }
  .teaser__content {
    position: relative;
  }
  .teaser h2 {
    margin: 0 0 1.5rem;
    max-width: 15ch;
    color: var(--ivory);
  }
  .teaser__text {
    max-width: 30rem;
    margin: 0 0 2.25rem;
    color: rgba(247, 243, 236, 0.88);
    font-weight: 300;
    font-size: 1.1rem;
  }
</style>
