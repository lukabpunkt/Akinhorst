---
import Eyebrow from "../Eyebrow.astro";
import Icon from "../Icon.astro";
import { site } from "../../data/site";
---

<section class="section occ" id="anlaesse" aria-labelledby="occ-title" data-occ>
  <div class="container occ__grid">
    <div class="occ__head">
      <Eyebrow text="Für jeden Anlass" align="left" />
      <h2 id="occ-title" data-anim="lines">Wofür <em class="accent">ihr</em> feiert.</h2>
      <p class="occ__note" data-anim="fade-up">Ob großes Fest oder kleine Runde im Garten – das Zelt schafft den Rahmen, ihr füllt ihn mit Leben.</p>
    </div>
    <ul class="occ__list" data-anim="stagger">
      {site.occasions.map((o, i) => (
        <li class="occ__row">
          {/* Klick: zum Formular, Anlass wird vorausgewählt (animations.ts) */}
          <a class="occ__link" href={`/?anlass=${encodeURIComponent(o)}#kontakt`} data-anlass={o}>
            <span class="occ__num" aria-hidden="true">0{i + 1}</span>
            <span class="occ__name">{o}<span class="sr-only"> – Termin anfragen</span></span>
            <Icon name="arrow" class="icon occ__arrow" />
            <span class="occ__line" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .occ__grid {
    display: grid;
    gap: 3rem;
  }
  .occ h2 {
    margin: 0 0 1.5rem;
  }
  .occ__note {
    color: var(--ink-soft);
    max-width: 24rem;
    margin: 0;
  }
  .occ__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--stone);
  }
  .occ__row {
    border-bottom: 1px solid var(--stone);
  }
  .occ__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 3.5rem;
    padding: 1rem 0;
    color: inherit;
    text-decoration: none;
  }
  .occ__num {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .occ__name {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.2vw + 1rem, 4rem);
    line-height: 1.05;
  }
  .occ__num,
  .occ__name,
  .occ__link :global(.occ__arrow) {
    transition: transform 0.7s var(--ease-luxe), color 0.4s ease, opacity 0.4s ease;
  }
  .occ__link :global(.occ__arrow) {
    margin-left: auto;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--gold-deep);
    opacity: 0.7;
  }
  .occ__line {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease-luxe);
  }
  .occ__link:focus-visible .occ__line,
  .occ__link:active .occ__line {
    transform: scaleX(1);
  }
  @media (hover: hover) {
    .occ__link :global(.occ__arrow) {
      opacity: 0;
      transform: translateX(-12px);
    }
    .occ__link:hover .occ__num,
    .occ__link:hover .occ__name {
      transform: translateX(24px);
    }
    .occ__link:hover .occ__num {
      color: var(--gold-deep);
    }
    .occ__link:hover :global(.occ__arrow),
    .occ__link:focus-visible :global(.occ__arrow) {
      opacity: 1;
      transform: none;
    }
    .occ__link:hover .occ__line {
      transform: scaleX(1);
    }
  }
  @media (min-width: 1024px) {
    .occ__grid {
      grid-template-columns: repeat(12, 1fr);
    }
    .occ__head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: 120px;
    }
    .occ__list {
      grid-column: 6 / span 7;
    }
  }
</style>
