---
import Eyebrow from "../Eyebrow.astro";
import { site } from "../../data/site";
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <Eyebrow text="FAQ" align="left" />
      <h2 id="faq-title" data-anim="lines">Gut zu <em class="accent">wissen.</em></h2>
      <p class="faq__intro" data-anim="fade-up">Eure Frage ist nicht dabei? <a class="tlink" href="#kontakt">Schreibt uns</a> – wir antworten persönlich.</p>
    </div>
    <div class="faq__list" data-faq data-anim="stagger">
      {site.faq.map((f, i) => (
        <div class="faq__item" data-faq-item>
          <h3 class="faq__q">
            <button type="button" id={`faq-btn-${i}`} aria-expanded="false" aria-controls={`faq-panel-${i}`} data-faq-btn>
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="faq__panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`} data-faq-panel>
            <div class="faq__a">
              {/* TODO(INHABER): Antwort prüfen */}
              <p>{f.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--paper);
  }
  .faq__grid {
    display: grid;
    gap: 3rem;
  }
  .faq h2 {
    margin: 0 0 1.5rem;
  }
  .faq__intro {
    margin: 0;
    color: var(--ink-soft);
    max-width: 22rem;
  }
  .faq__list {
    border-top: 1px solid var(--stone);
  }
  .faq__item {
    border-bottom: 1px solid var(--stone);
  }
  .faq__q {
    margin: 0;
    font-size: inherit;
  }
  .faq__q button {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.6rem 0;
    background: none;
    border: 0;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 0.8vw + 1rem, 1.75rem);
    line-height: 1.25;
    transition: color 0.3s ease;
  }
  @media (hover: hover) {
    .faq__q button:hover {
      color: var(--gold-deep);
    }
  }
  .faq__icon {
    position: relative;
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform 0.6s var(--ease-luxe);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: var(--gold-deep);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  [aria-expanded="true"] .faq__icon {
    transform: rotate(135deg);
  }
  .faq__panel {
    overflow: hidden;
  }
  :global(.faq-js) .faq__panel:not(.is-open) {
    height: 0;
  }
  :global(.faq-js) .faq__panel[hidden] {
    display: block;
  }
  .faq__a p {
    margin: 0;
    padding: 0 0 1.5rem 0;
    color: var(--ink-soft);
    max-width: 40rem;
  }
  @media (min-width: 768px) {
    .faq__a p {
      padding: 0 3rem 1.75rem 0;
    }
  }
  @media (min-width: 1024px) {
    .faq__grid {
      grid-template-columns: repeat(12, 1fr);
    }
    .faq__head {
      grid-column: 1 / span 4;
    }
    .faq__list {
      grid-column: 6 / span 7;
    }
  }
</style>
